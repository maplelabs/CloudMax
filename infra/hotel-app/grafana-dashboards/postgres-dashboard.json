{
  "id": null,
  "uid": "postgres-metrics-dashboard",
  "title": "PostgreSQL Performance Dashboard",
  "tags": ["postgresql", "database", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "refresh": "5s",
  "schemaVersion": 30,
  "style": "dark",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Database Status",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "pg_up",
          "legendFormat": "Status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Active Connections",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"postgres\"}",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "title": "Database Size",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"postgres\"} / 1024 / 1024",
          "legendFormat": "Size (MB)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MB",
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4,
      "title": "Transactions per Second",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"postgres\"}[5m])",
          "legendFormat": "Commits/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"postgres\"}[5m])",
          "legendFormat": "Rollbacks/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
    },
    {
      "id": 5,
      "title": "Database I/O",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_read{datname=\"postgres\"}[5m])",
          "legendFormat": "Blocks Read/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_blks_hit{datname=\"postgres\"}[5m])",
          "legendFormat": "Blocks Hit/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
    },
    {
      "id": 6,
      "title": "Cache Hit Ratio",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{datname=\"postgres\"} / (pg_stat_database_blks_hit{datname=\"postgres\"} + pg_stat_database_blks_read{datname=\"postgres\"}) * 100",
          "legendFormat": "Hit Ratio %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 80},
              {"color": "green", "value": 95}
            ]
          }
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 7,
      "title": "Locks by Type",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum(pg_locks_count) by (mode)",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}
    },
    {
      "id": 8,
      "title": "Database Inserts",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 14}
    },
    {
      "id": 9,
      "title": "Database Updates",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_updated{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 22}
    },
    {
      "id": 10,
      "title": "Database Deletes",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_deleted{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 22}
    },
    {
      "id": 11,
      "title": "Database Fetches",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 28}
    },
    {
      "id": 12,
      "title": "Transaction Failures",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "{{datname}} - Rollbacks/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_deadlocks{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "{{datname}} - Deadlocks/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 28}
    },
    {
      "id": 13,
      "title": "Database Conflicts",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_conflicts_confl_lock{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "{{datname}} - Lock Conflicts",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_conflicts_confl_deadlock{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "{{datname}} - Deadlock Conflicts",
          "refId": "B"
        },
        {
          "expr": "rate(pg_stat_database_conflicts_confl_snapshot{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "{{datname}} - Snapshot Conflicts",
          "refId": "C"
        },
        {
          "expr": "rate(pg_stat_database_conflicts_confl_bufferpin{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "{{datname}} - Buffer Pin Conflicts",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 34}
    },
    {
      "id": 14,
      "title": "Archive Failures",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "pg_stat_archiver_failed_count",
          "legendFormat": "Failed Archives",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      },
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 34}
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}




