{
  "id": null,
  "uid": "nginx-metrics-dashboard",
  "title": "nginx Performance Dashboard",
  "tags": ["nginx", "monitoring", "performance"],
  "timezone": "browser",
  "editable": true,
  "refresh": "5s",
  "schemaVersion": 30,
  "style": "dark",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Active Connections",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "nginx_connections_active",
          "legendFormat": "Active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          }
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Request Rate",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[5m])",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "title": "Total Requests",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "nginx_http_requests_total",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4,
      "title": "nginx Status",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "nginx_up",
          "legendFormat": "Up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {"options": {"0": {"text": "DOWN", "color": "red"}}, "type": "value"},
            {"options": {"1": {"text": "UP", "color": "green"}}, "type": "value"}
          ]
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 5,
      "title": "Connection States Over Time",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "nginx_connections_active",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "nginx_connections_reading",
          "legendFormat": "Reading",
          "refId": "B"
        },
        {
          "expr": "nginx_connections_writing",
          "legendFormat": "Writing",
          "refId": "C"
        },
        {
          "expr": "nginx_connections_waiting",
          "legendFormat": "Waiting",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
    },
    {
      "id": 6,
      "title": "HTTP Status Codes",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum by (status) (rate(nginx_http_response_count_total{method=\"\",path=\"\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
    },
    {
      "id": 7,
      "title": "Response Time Distribution",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(nginx_http_response_time_seconds_hist_bucket[5m]))",
          "legendFormat": "50th percentile",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, rate(nginx_http_response_time_seconds_hist_bucket[5m]))",
          "legendFormat": "90th percentile",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(nginx_http_response_time_seconds_hist_bucket[5m]))",
          "legendFormat": "99th percentile",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14}
    },
    {
      "id": 8,
      "title": "Request Rate Trend",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[5m])",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 22}
    },
    {
      "id": 9,
      "title": "Total HTTP Status Codes",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "nginx_http_response_count_total{method=\"\",path=\"\"}",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 30}
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}


