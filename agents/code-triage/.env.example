# LLM Configuration
# Mode: AWS_BEDROCK or AZURE_ANTHROPIC
LLM_MODE=AZURE_ANTHROPIC

# ===== Azure Anthropic Configuration =====
Required when LLM_MODE=AZURE_ANTHROPIC
AZURE_ANTHROPIC_ENDPOINT=https://cloudmax-claude-sonnet-resource.services.ai.azure.com/anthropic/
AZURE_ANTHROPIC_API_KEY=your-azure-api-key-here
AZURE_ANTHROPIC_MODEL_ID=claude-haiku-4-5
AZURE_ANTHROPIC_MAX_TOKENS=4096
AZURE_ANTHROPIC_TEMPERATURE=0.1

# ===== AWS Bedrock Configuration =====
Required when LLM_MODE=AWS_BEDROCK
BEDROCK_API_KEY=your-bedrock-bearer-token-here
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.1

# ===== GitHub Configuration =====
# Required for both modes
GITHUB_TOKEN=your-github-token-here
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly

# ===== Agent Configuration =====
ORCHESTRATOR_PORT=8002
LOG_LEVEL=INFO
