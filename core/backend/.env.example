# ---------------------------------------------------------------------
# Configuration Source
# By default, CONFIG_DB=true (loads all LLM, embedding, and MCP configuration from database)
# Only uncomment and set to false if you want to use environment variables below (legacy mode)
# ---------------------------------------------------------------------
# CONFIG_DB=false

## Code Triage Agent Configuration
##
## NOTE:
## - GitHub / Bedrock credentials and agent-specific settings now live in
##   code-triage-agent/.env (see code-triage-agent/.env.example for details).
## - The backend only needs these CODE_TRIAGE_* knobs to control whether and
##   how it calls the agent.

# Backend - Enable Code Triage
CODE_TRIAGE_ENABLED=true
CODE_TRIAGE_BASE_URL=http://code-triage-agent:8002
CODE_TRIAGE_TIMEOUT=180
CODE_TRIAGE_MAX_RETRIES=3

# ---------------------------------------------------------------------
# Legacy Environment Variable Configuration (only used when CONFIG_DB=false)
# When CONFIG_DB=true, all LLM/embedding/MCP settings are managed through the web UI
# ---------------------------------------------------------------------
# Uncomment and configure these only if you set CONFIG_DB=false:

# LLM Provider Configuration
# Options: AZURE_OPENAI, AWS_BEDROCK
# LLM_MODE=AZURE_OPENAI

# Azure OpenAI LLM Configuration (Required when LLM_MODE=AZURE_OPENAI)
# AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_API_KEY=your-api-key-here

# LLM Pricing Configuration (USD per 1000 tokens)
# PRICE_USD_PER_1K_IP_TOKENS=0.01
# PRICE_USD_PER_1K_OP_TOKENS=0.03

# Azure OpenAI Embedding Configuration
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-openai-resource.openai.azure.com/
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
# AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01

# Common Azure OpenAI API Key
# AZURE_OPENAI_API_KEY=

# AWS Bedrock Configuration
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=your-aws-access-key-here
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here

# MCP Server Configuration
# GRAFANA_MCP_URL=http://128.203.70.175:8000/sse
# JAEGER_MCP_URL=http://20.253.110.251:8000/sse

# ---------------------------------------------------------------------
# Langchain / LangGraph Checkpointer Configuration
# Defaults for local dev (backend-dev compose exposes Postgres on 5433)
# ---------------------------------------------------------------------
# POSTGRES_CHECKPOINTER_CONN_STRING=postgresql://otelu:otelp@postgres:5432/checkpoint?sslmode=disable
# DATABASE_URL=postgresql+asyncpg://otelu:otelp@postgres:5432/sreops

# ---------------------------------------------------------------------
# Redis-Queue (Python RQ) Configuration
# ---------------------------------------------------------------------
# REDIS_QUEUE_HOST=localhost
# REDIS_QUEUE_PORT=6379
# REDIS_QUEUE_AUTH=queueredissecret
# REDIS_QUEUE_DB=1

# ---------------------------------------------------------------------
# Alert Grouping & Correlation Configuration
# ---------------------------------------------------------------------
# Feature Flags
# NOTE: alert_grouping_enabled is now database-driven via app_config table
# Use the Setup UI or /v1/config API to enable/disable alert grouping
GROUP_TRIAGE_ENABLED=true

# Worker / Queue Configuration
RQ_GROUPING_QUEUE_NAME=alert_grouping
RQ_TRIAGE_QUEUE_NAME=group_triage

# Fail-Safe Configuration
GROUPING_FAILURE_RETRY_ATTEMPTS=3
GROUPING_FAILURE_RETRY_DELAY_SECONDS=60

# ---------------------------------------------------------------------
# Langfuse Tracing Defaults for local dev; docker-compose overrides in containers
# ---------------------------------------------------------------------
# LANGFUSE_TRACING=true
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=lf_public_dev_cloud_sre_ops
# LANGFUSE_SECRET_KEY=lf_secret_dev_cloud_sre_ops
