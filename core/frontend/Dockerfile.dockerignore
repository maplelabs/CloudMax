# Default-deny: only the frontend build tree and the one root notices file
# are sent as build context.
**
!THIRD_PARTY_NOTICES.md
!core/
!core/frontend/
!core/frontend/**

# Exclude secrets, dependencies, generated outputs, and caches.
core/frontend/.env*
core/frontend/**/.env*
core/frontend/node_modules/
core/frontend/**/node_modules/
core/frontend/dist/
core/frontend/**/dist/
core/frontend/build/
core/frontend/**/build/
core/frontend/.git/
core/frontend/**/.git/
core/frontend/.vscode/
core/frontend/.idea/
core/frontend/coverage/
core/frontend/**/coverage/
core/frontend/.next/
core/frontend/**/.next/
core/frontend/.nuxt/
core/frontend/**/.nuxt/
core/frontend/.npm/
core/frontend/**/.npm/
core/frontend/jspm_packages/
core/frontend/**/jspm_packages/
core/frontend/tmp/
core/frontend/**/tmp/
core/frontend/temp/
core/frontend/**/temp/
core/frontend/logs/
core/frontend/**/logs/
core/frontend/**/*.log
core/frontend/**/*.lcov
core/frontend/**/*.swp
core/frontend/**/*.swo
core/frontend/**/*.pem
core/frontend/**/*.key
core/frontend/**/*.p12
core/frontend/**/*.pfx
core/frontend/**/*.tgz
core/frontend/.dockerignore
core/frontend/Dockerfile
core/frontend/Dockerfile.dockerignore
